
:root {
    --bg: #101216;
    --panel: #191e27;
    --panel2: #202633;
    --line: #2b3341;
    --text: #edf1f7;
    --muted: #8293ad;
    --orange: #ffa500;
    --orange-dark: #392916;
    --green: #10c99a;
    --red: #ff515c;
  }
  
  * {
    box-sizing: border-box;
  }
  
  body {
    margin: 0;
    min-height: 100vh;
    display: flex;
    justify-content: center;
    background: #080a0d;
    color: var(--text);
    font-family: Inter, ui-sans-serif, system-ui, -apple-system,
      BlinkMacSystemFont, "Segoe UI", sans-serif;
  }
  
  button,
  input,
  select {
    font: inherit;
  }
  
  button {
    cursor: pointer;
  }
  
  button:disabled {
    opacity: 0.6;
    cursor: wait;
  }
  
  a {
    color: var(--orange);
  }
  
  .hidden {
    display: none !important;
  }
  
  .phone-shell {
    position: relative;
    width: 100%;
    max-width: 470px;
    min-height: 100vh;
    overflow: hidden;
    background: var(--bg);
    box-shadow: 0 0 0 1px #242933;
  }
  
  .screen {
    min-height: 100vh;
    padding: 28px 20px 105px;
  }
  
  .muted {
    color: var(--muted);
    line-height: 1.55;
  }
  
  .eyebrow {
    margin: 0 0 8px;
    color: var(--orange);
    font-size: 11px;
    font-weight: 850;
    letter-spacing: 1.4px;
  }
  
  /* Login */
  
  .login-screen {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-top: 38px;
  }
  
  .brand-mark {
    width: 54px;
    height: 54px;
    margin-bottom: 24px;
    border-radius: 17px;
    background: var(--orange);
    color: #101216;
    font-size: 43px;
    font-weight: 900;
    line-height: 50px;
    text-align: center;
  }
  
  .login-screen h1 {
    margin: 8px 0 16px;
    font-size: 38px;
    line-height: 1.04;
    letter-spacing: -1.3px;
  }
  
  .intro {
    max-width: 310px;
    margin: 0 0 30px;
    font-size: 15px;
  }
  
  .login-card,
  .info-card,
  .empty-card,
  .profile-card {
    padding: 18px;
    border: 1px solid var(--line);
    border-radius: 20px;
    background: var(--panel);
  }
  
  .login-card label {
    display: block;
    margin: 0 0 8px;
    color: #9caac0;
    font-size: 10px;
    font-weight: 850;
    letter-spacing: 1.3px;
  }
  
  .login-card input {
    width: 100%;
    margin-bottom: 18px;
    padding: 15px;
    border: 1px solid var(--line);
    border-radius: 11px;
    outline: none;
    background: var(--panel2);
    color: var(--text);
  }
  
  .login-card input:focus,
  .records-toolbar input:focus,
  .records-toolbar select:focus {
    border-color: var(--orange);
  }
  
  .primary {
    padding: 15px 16px;
    border: 0;
    border-radius: 12px;
    background: var(--orange);
    color: #17120a;
    font-weight: 850;
  }
  
  .full {
    width: 100%;
  }
  
  .tiny {
    margin: 12px 0 0;
    font-size: 10px;
  }
  
  /* Header */
  
  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 28px;
  }
  
  .topbar h2 {
    margin: 0;
    font-size: 28px;
    letter-spacing: -0.7px;
  }
  
  .status-pill {
    padding: 8px 10px;
    border: 1px solid #253c3a;
    border-radius: 30px;
    color: var(--green);
    font-size: 10px;
    font-weight: 850;
    letter-spacing: 0.6px;
  }
  
  .status-pill i {
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-right: 5px;
    border-radius: 50%;
    background: var(--green);
  }
  
  /* Workspace */
  
  .scan-hero {
    display: flex;
    align-items: center;
    gap: 13px;
    width: 100%;
    margin-bottom: 16px;
    padding: 17px 15px;
    border: 1px solid #9b5c00;
    border-radius: 17px;
    background: var(--orange-dark);
    color: var(--text);
    text-align: left;
  }
  
  .hero-icon {
    display: grid;
    flex-shrink: 0;
    width: 49px;
    height: 49px;
    place-items: center;
    border-radius: 14px;
    background: var(--orange);
    color: #111;
    font-size: 32px;
  }
  
  .scan-hero span:nth-child(2) {
    flex: 1;
    min-width: 0;
  }
  
  .scan-hero strong,
  .scan-hero small {
    display: block;
  }
  
  .scan-hero strong {
    font-size: 15px;
  }
  
  .scan-hero small {
    margin-top: 5px;
    color: #ffd06a;
    font-size: 10px;
  }
  
  .scan-hero b {
    color: var(--orange);
    font-size: 25px;
  }
  
  .stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 9px;
    margin-bottom: 27px;
  }
  
  .stat-card {
    min-height: 100px;
    padding: 14px 12px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--panel);
  }
  
  .stat-card small {
    display: block;
    color: #91a0b7;
    font-size: 9px;
    font-weight: 850;
    letter-spacing: 1px;
  }
  
  .stat-card strong {
    display: block;
    margin-top: 9px;
    font-size: 25px;
  }
  
  .stat-card .offline {
    color: #f0b56c;
    font-size: 17px;
    line-height: 1.1;
  }
  
  .section-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin: 0 0 13px;
  }
  
  .section-heading h3 {
    margin: 0;
    font-size: 17px;
  }
  
  .text-button {
    border: 0;
    background: transparent;
    color: var(--orange);
    font-size: 10px;
    font-weight: 900;
    letter-spacing: 0.8px;
  }
  
  .empty-card {
    padding: 25px 18px;
    text-align: center;
  }
  
  .empty-icon {
    margin-bottom: 12px;
    color: var(--orange);
    font-size: 28px;
  }
  
  .empty-card strong {
    display: block;
  }
  
  .empty-card p {
    margin-bottom: 0;
    font-size: 12px;
  }
  
  .notice {
    margin-top: 18px;
    padding: 15px;
    border: 1px solid #62481f;
    border-radius: 14px;
    background: #2c2418;
    color: #f0d4a3;
    font-size: 12px;
  }
  
  .notice p {
    margin-bottom: 0;
    color: #c6ab80;
    line-height: 1.5;
  }
  
  /* Scan page */
  
  .upload-box {
    display: flex;
    min-height: 180px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin: 22px 0 16px;
    padding: 22px;
    border: 1px dashed #9b690f;
    border-radius: 17px;
    background: #2d2417;
    color: var(--orange);
    text-align: center;
  }
  
  .upload-icon {
    font-size: 35px;
  }
  
  .upload-box strong {
    color: var(--text);
    overflow-wrap: anywhere;
  }
  
  .upload-box small {
    color: #ffd06a;
    font-size: 10px;
  }
  
  .upload-box input {
    max-width: 100%;
    color: var(--muted);
    font-size: 11px;
  }
  
  .info-card {
    display: grid;
    gap: 20px;
    margin-bottom: 18px;
  }
  
  .info-card b {
    font-size: 13px;
  }
  
  .info-card p {
    margin: 6px 0 0;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.5;
  }
  
  .message {
    margin-top: 15px;
    padding: 13px;
    border: 1px solid #31504a;
    border-radius: 12px;
    background: #1e2b2a;
    color: #b7e9d8;
    font-size: 12px;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }
  
  .message.error {
    border-color: #69343b;
    background: #321d21;
    color: #ffc2c7;
  }
  
  .scan-report-link {
    display: inline-block;
    margin-top: 10px;
    font-weight: 800;
  }
  
  /* Record cards shared by Workspace, History and Records */
  
  .record-list {
    display: grid;
    gap: 12px;
  }
  
  .record-card {
    min-width: 0;
    padding: 15px;
    border: 1px solid var(--line);
    border-radius: 15px;
    background: var(--panel);
  }
  
  .record-card-top {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }
  
  .record-icon {
    display: grid;
    flex-shrink: 0;
    width: 42px;
    height: 42px;
    place-items: center;
    border-radius: 12px;
    background: var(--panel2);
    color: var(--orange);
    font-size: 21px;
  }
  
  .record-file {
    min-width: 0;
    flex: 1;
  }
  
  .record-file strong {
    display: block;
    overflow-wrap: anywhere;
    font-size: 13px;
  }
  
  .record-file small {
    display: block;
    margin-top: 5px;
    color: var(--muted);
    font-size: 10px;
    line-height: 1.45;
    overflow-wrap: anywhere;
  }
  
  .record-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-top: 13px;
  }
  
  .record-tags span {
    padding: 5px 8px;
    border: 1px solid #3b414d;
    border-radius: 7px;
    color: #d0b17e;
    font-size: 10px;
  }
  
  .record-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 9px;
    margin-top: 13px;
  }
  
  .record-actions button,
  .record-actions a,
  .secondary-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 8px 10px;
    border: 1px solid var(--line);
    border-radius: 9px;
    background: var(--panel2);
    color: var(--text);
    font-size: 11px;
    text-decoration: none;
  }
  
  .record-actions a {
    color: var(--orange);
  }
  
  .record-actions .delete-record {
    margin-left: auto;
    border-color: #66343a;
    color: #ff9299;
  }
  
  .record-details {
    margin-top: 15px;
    padding-top: 15px;
    border-top: 1px solid var(--line);
  }
  
  /* Video details and frames */
  
  .video-details {
    display: grid;
    gap: 14px;
    margin-top: 18px;
    padding: 16px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--panel);
  }
  
  .video-details h4 {
    margin: 0;
    font-size: 14px;
  }
  
  .video-meta {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }
  
  .video-meta > div {
    min-width: 0;
    padding: 11px;
    border-radius: 10px;
    background: var(--panel2);
  }
  
  .video-meta small {
    display: block;
    margin-bottom: 5px;
    color: var(--muted);
    font-size: 10px;
  }
  
  .video-meta strong {
    display: block;
    overflow-wrap: anywhere;
    font-size: 12px;
  }
  
  .frame-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
  }
  
  .frame-card {
    min-width: 0;
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--panel2);
  }
  
  .frame-card a {
    display: block;
  }
  
  .frame-card img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    background: #101216;
  }
  
  .frame-card figcaption {
    padding: 7px;
    color: var(--muted);
    font-size: 10px;
    overflow-wrap: anywhere;
  }
  
  .video-note {
    margin: 0;
    color: var(--muted);
    font-size: 11px;
    line-height: 1.5;
  }
  
  /* Records page */
  
  .records-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 20px;
  }
  
  .records-header h3 {
    margin: 0;
    font-size: 23px;
    letter-spacing: -0.5px;
  }
  
  .records-header p:not(.eyebrow) {
    margin: 7px 0 0;
    font-size: 12px;
  }
  
  .records-header .eyebrow {
    margin-bottom: 8px;
  }
  
  .secondary-button {
    padding: 10px 12px;
    color: var(--orange);
  }
  
  .records-summary {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 9px;
    margin-bottom: 18px;
  }
  
  .record-stat {
    min-width: 0;
    padding: 13px 10px;
    border: 1px solid var(--line);
    border-radius: 13px;
    background: var(--panel);
  }
  
  .record-stat small {
    display: block;
    color: var(--muted);
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.5px;
  }
  
  .record-stat strong {
    display: block;
    margin-top: 8px;
    font-size: 24px;
  }
  
  .records-toolbar {
    display: flex;
    gap: 9px;
    margin-bottom: 16px;
  }
  
  .records-toolbar input,
  .records-toolbar select {
    min-width: 0;
    padding: 12px 10px;
    border: 1px solid var(--line);
    border-radius: 10px;
    outline: none;
    background: var(--panel);
    color: var(--text);
    font-size: 12px;
  }
  
  .records-toolbar input {
    flex: 1;
    width: 100%;
  }
  
  .records-toolbar select {
    max-width: 125px;
  }
  
  .records-toolbar option {
    background: var(--panel);
    color: var(--text);
  }
  
  /* Profile */
  
  .profile-card {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 16px;
  }
  
  .profile-avatar {
    display: grid;
    width: 52px;
    height: 52px;
    flex-shrink: 0;
    place-items: center;
    border-radius: 15px;
    background: var(--orange);
    color: #17120a;
    font-size: 25px;
  }
  
  .profile-card strong {
    overflow-wrap: anywhere;
    font-size: 14px;
  }
  
  .profile-card .eyebrow {
    margin: 5px 0 0;
    font-size: 9px;
  }
  
  .profile-info {
    margin-bottom: 16px;
  }
  
  .danger {
    padding: 14px;
    border: 1px solid #85353c;
    border-radius: 12px;
    background: transparent;
    color: var(--red);
    font-weight: 800;
  }
  
  /* Bottom navigation */
  
  .bottom-nav {
    position: fixed;
    z-index: 5;
    bottom: 0;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    width: min(100%, 470px);
    padding: 8px 3px 10px;
    border-top: 1px solid #dce0e6;
    background: #f7f8fa;
  }
  
  .nav-item {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: 4px 1px;
    border: 0;
    background: transparent;
    color: #748197;
    font-size: 10px;
    font-weight: 750;
  }
  
  .nav-item span {
    font-size: 21px;
    line-height: 24px;
  }
  
  .nav-item.active {
    color: #e58f00;
  }
  
  /* Responsive layout */
  
  @media (min-width: 600px) {
    .frame-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  
  @media (min-width: 700px) {
    body {
      padding: 24px 0;
    }
  
    .phone-shell {
      min-height: 850px;
      overflow: hidden;
      border-radius: 30px;
    }
  
    .screen {
      min-height: 850px;
    }
  
    .bottom-nav {
      position: absolute;
      bottom: 0;
      border-radius: 0 0 30px 30px;
    }
  
    .login-screen {
      min-height: 850px;
    }
  }
  
  @media (max-width: 360px) {
    .screen {
      padding-right: 14px;
      padding-left: 14px;
    }
  
    .records-summary {
      gap: 6px;
    }
  
    .record-stat {
      padding: 10px 7px;
    }
  
    .record-stat small {
      font-size: 8px;
    }
  
    .records-toolbar {
      flex-direction: column;
    }
  
    .records-toolbar select {
      max-width: none;
    }
  
    .frame-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  
/* DeepGuard confidence meter */
.confidence-panel {
  margin-top: 18px;
  padding: 18px;
  border: 1px solid var(--border-color, #343b49);
  border-radius: 14px;
  background: var(--card-bg, rgba(127, 127, 127, 0.07));
}

.confidence-panel h3 {
  margin: 0 0 12px;
}

.confidence-verdict {
  font-size: 1.1rem;
  font-weight: 700;
  margin: 8px 0;
}

.confidence-label,
.confidence-scores {
  margin: 10px 0;
  font-size: 0.92rem;
}

.confidence-track {
  width: 100%;
  height: 12px;
  overflow: hidden;
  border-radius: 999px;
  background: rgba(127, 127, 127, 0.22);
}

.confidence-fill {
  height: 100%;
  border-radius: inherit;
  background: #48a879;
  transition: width 0.35s ease;
}

.confidence-warning {
  display: block;
  margin-top: 12px;
  line-height: 1.5;
  opacity: 0.8;
}
